#include <LSS.h>

LSS myLSS = LSS(0); // ID: 0-5 -> 1-6

void setup()
{
	LSS::initBus(Serial, LSS_DefaultBaud);
	myLSS.move(0);
	delay(2000);
}

void loop()
{
	Move(36, 30);
	delay(2000);

	Move(-90, 100);
	delay(2000);
}

void Move(int degrees, int percent)
{
	int pos = degrees * 10;
	int speed = percent * 36;

	myLSS.moveSpeed(pos, speed);
}
